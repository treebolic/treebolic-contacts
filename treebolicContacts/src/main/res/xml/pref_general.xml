<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

	<EditTextPreference
		android:capitalize="none"
		android:defaultValue="@string/pref_default_source"
		android:inputType="text"
		android:key="pref_source"
		android:maxLines="1"
		android:selectAllOnFocus="true"
		android:singleLine="true"
		android:summary="@string/pref_description_source"
		android:title="@string/pref_title_source"/>

	<CheckBoxPreference
		android:defaultValue="false"
		android:key="pref_groups"
		android:title="@string/pref_title_groups"/>

	<CheckBoxPreference
		android:defaultValue="true"
		android:key="pref_merge_groups"
		android:title="@string/pref_title_merge_groups"/>

	<ListPreference
		android:defaultValue="@string/pref_display_value_first_last"
		android:entries="@array/pref_display_labels"
		android:entryValues="@array/pref_display_values"
		android:key="pref_display"
		android:negativeButtonText="@null"
		android:positiveButtonText="@null"
		android:summary="@string/pref_description_display"
		android:title="@string/pref_title_display"/>

	<ListPreference
		android:defaultValue="@string/pref_sort_value_last"
		android:entries="@array/pref_sort_labels"
		android:entryValues="@array/pref_sort_values"
		android:key="pref_sort"
		android:negativeButtonText="@null"
		android:positiveButtonText="@null"
		android:summary="@string/pref_description_sort"
		android:title="@string/pref_title_sort"/>

</androidx.preference.PreferenceScreen>