<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="org.treebolic.contacts">

	<uses-permission android:name="android.permission.READ_CONTACTS"/>

	<application
		android:allowBackup="true"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:supportsRtl="true"
		android:theme="@style/CompatAppTheme"
		android:fullBackupContent="@xml/backup_descriptor">

		<activity
			android:name=".MainActivity"
			android:label="@string/title_activity_main">
			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>
				<category android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>
		</activity>

		<activity
			android:name=".ListContactsActivity"
			android:label="@string/title_activity_list_contacts"
			android:parentActivityName=".MainActivity"
			tools:targetApi="jelly_bean">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity"/>
		</activity>

		<activity
			android:name=".ListContactsGroupedActivity"
			android:label="@string/title_activity_list_grouped_contacts"
			android:parentActivityName=".MainActivity"
			tools:targetApi="jelly_bean">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity"/>
		</activity>

		<activity
			android:name=".ListContactsUnGroupedActivity"
			android:label="@string/title_activity_list_ungrouped_contacts"
			android:parentActivityName=".MainActivity"
			tools:targetApi="jelly_bean">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity"/>
		</activity>

		<activity
			android:name=".ListGroupsActivity"
			android:label="@string/title_activity_list_groups"
			android:parentActivityName=".MainActivity"
			tools:targetApi="jelly_bean">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity"/>
		</activity>

		<activity
			android:name="org.treebolic.contacts.TreebolicActivity"
			android:hardwareAccelerated="true"
			android:label="@string/title_activity_treebolic"
			android:parentActivityName=".MainActivity"
			tools:targetApi="jelly_bean">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity"/>
		</activity>

		<activity
			android:name="org.treebolic.contacts.SettingsActivity"
			android:label="@string/title_activity_settings"
			android:parentActivityName=".MainActivity"
			tools:targetApi="jelly_bean">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity"/>
		</activity>

	</application>

</manifest>