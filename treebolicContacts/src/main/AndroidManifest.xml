<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<uses-permission android:name="android.permission.READ_CONTACTS" />

	<application
		android:allowBackup="true"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:enableOnBackInvokedCallback="true"
		android:fullBackupContent="@xml/backup_descriptor"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:supportsRtl="true"
		android:theme="@style/MyTheme"
		tools:targetApi="tiramisu">

		<activity
			android:name="org.treebolic.contacts.MainActivity"
			android:exported="true"
			android:label="@string/title_activity_main">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<activity
			android:name="org.treebolic.contacts.TreebolicActivity"
			android:exported="true"
			android:hardwareAccelerated="true"
			android:label="@string/title_activity_treebolic"
			android:parentActivityName="org.treebolic.contacts.MainActivity">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity" />
		</activity>

		<activity
			android:name="org.treebolic.contacts.ListContactsActivity"
			android:exported="false"
			android:label="@string/title_activity_list_contacts"
			android:parentActivityName="org.treebolic.contacts.MainActivity">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity" />
		</activity>

		<activity
			android:name="org.treebolic.contacts.ListContactsGroupedActivity"
			android:exported="false"
			android:label="@string/title_activity_list_grouped_contacts"
			android:parentActivityName="org.treebolic.contacts.MainActivity">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity" />
		</activity>

		<activity
			android:name="org.treebolic.contacts.ListContactsUnGroupedActivity"
			android:exported="false"
			android:label="@string/title_activity_list_ungrouped_contacts"
			android:parentActivityName="org.treebolic.contacts.MainActivity">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity" />
		</activity>

		<activity
			android:name="org.treebolic.contacts.ListGroupsActivity"
			android:exported="false"
			android:label="@string/title_activity_list_groups"
			android:parentActivityName="org.treebolic.contacts.MainActivity">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity" />
		</activity>

		<activity
			android:name="org.treebolic.contacts.SettingsActivity"
			android:exported="false"
			android:label="@string/title_activity_settings"
			android:parentActivityName="org.treebolic.contacts.MainActivity">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity" />
		</activity>

		<activity
			android:name="org.treebolic.contacts.FilterActivity"
			android:exported="false"
			android:label="@string/title_activity_filter"
			android:parentActivityName="org.treebolic.contacts.MainActivity">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity" />
		</activity>

		<activity
			android:name="org.treebolic.guide.HelpActivity"
			android:exported="false"
			android:parentActivityName="org.treebolic.contacts.MainActivity">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity" />
		</activity>

		<activity
			android:name="com.bbou.others.OthersActivity"
			android:exported="false"
			android:parentActivityName="org.treebolic.contacts.MainActivity">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity" />
		</activity>

		<activity
			android:name="com.bbou.donate.DonateActivity"
			android:exported="false"
			android:parentActivityName="org.treebolic.contacts.MainActivity">
			<meta-data
				android:name="android.support.PARENT_ACTIVITY"
				android:value="org.treebolic.contacts.MainActivity" />
		</activity>

	</application>

</manifest>